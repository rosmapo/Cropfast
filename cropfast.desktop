[Desktop Entry]
Type=Application
Name=CropFast
GenericName=Image Cropper
Comment=Fast image cropping tool with aspect-ratio presets
# Adjust this path to wherever you actually install cropfast.py,
# e.g. /usr/local/bin/cropfast or ~/.local/bin/cropfast
Exec=cropfast %f
Icon=image-x-generic
Terminal=false
Categories=Graphics;Photography;
MimeType=image/jpeg;image/png;image/bmp;image/gif;image/webp;
StartupNotify=true
